generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model Product {
  id                 String  @id @default(uuid())
  productId          String  @unique // MEESHO_1000000
  title              String
  category           String
  subcategory        String
  brand              String
  originalPrice      Float
  discountedPrice    Float
  discountPercentage Float
  rating             Float
  reviewCount        Int
  availability       String
  sellerName         String
  imageUrl           String
  productUrl         String
  description        String
  colorsAvailable    String
  sizesAvailable     String
  material           String
  codAvailable       Boolean
  returnPolicy       String
  deliveryTime       String
  
  orderItems         OrderItem[]
  flashLocks         FlashCheckoutLock[]
  priceHistory       PriceHistory[]
}

model PriceHistory {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price      Float
  recordedAt DateTime @default(now())

  @@index([productId])
}

model Order {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  total     Float
  status    String   @default("PENDING") // PENDING, COMPLETED, CANCELLED
  createdAt DateTime @default(now())
  
  items     OrderItem[]
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model FlashCheckoutLock {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  userId    String
  quantity  Int
  lockedAt  DateTime @default(now())
  expiresAt DateTime
}
